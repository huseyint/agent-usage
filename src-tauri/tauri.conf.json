{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Coding Usage",
  "version": "0.1.1",
  "identifier": "dev.local.agentusage",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AI Coding Usage",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      },
      {
        "label": "tray",
        "create": false,
        "title": "AI Coding Usage \u2014 Recent sessions",
        "url": "index.html?window=tray",
        "width": 420,
        "height": 650,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/CCUSAGE_LICENSE": "CCUSAGE_LICENSE",
      "../LICENSE": "LICENSE",
      "../docs/DEPENDENCY_LICENSES.txt": "DEPENDENCY_LICENSES.txt",
      "../docs/SBOM.spdx.json": "SBOM.spdx.json"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "externalBin": ["binaries/ccusage"],
    "publisher": "AI Coding Usage contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local-first Claude Code and Codex usage dashboard",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "bundleVCRuntime": true,
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "homepage": "https://github.com/huseyint/agent-usage"
  }
}
